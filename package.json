{
  "name": "pancho-plus-plus",
  "displayName": "Pancho++",
  "description": "Limpia y formatear texto como Notepad++",
  "version": "1.0.0",
  "publisher": "undaniels",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pancho/pancho.git"
  },
  "contributes": {
    "configuration": {
      "title": "Pancho",
      "properties": {
        "pancho.tabSize": {
          "type": "number",
          "default": 4,
          "description": "Tamaño de tabulación en espacios"
        },
        "pancho.indentWithSpaces": {
          "type": "boolean",
          "default": true,
          "description": "Usar espacios para indentación"
        },
        "pancho.defaultEOL": {
          "type": "string",
          "enum": [
            "LF",
            "CRLF",
            "CR"
          ],
          "default": "LF",
          "description": "Fin de línea por defecto"
        },
        "pancho.statusBarShowCounters": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar contadores en barra de estado"
        },
        "pancho.maxFileSizeKB": {
          "type": "number",
          "default": 5120,
          "description": "Tamaño máximo de archivo en KB para procesamiento (0 = sin límite)"
        },
        "pancho.loremIpsumWordCount": {
          "type": "number",
          "default": 50,
          "description": "Cantidad de palabras en Lorem Ipsum"
        },
        "pancho.randomStringLength": {
          "type": "number",
          "default": 16,
          "description": "Longitud de cadena aleatoria generada"
        }
      }
    },
    "configurationDefaults": {
      "editor": {
        "tabSize": 4,
        "insertSpaces": true
      }
    },
    "keybindings": [
      {
        "command": "pancho.toUpperCase",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u",
        "when": "editorTextFocus",
        "args": null,
        "accessibilityInformation": {
          "label": "Convertir texto a mayúsculas",
          "handledChannels": [
            "ui"
          ]
        }
      },
      {
        "command": "pancho.toLowerCase",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus",
        "args": null,
        "accessibilityInformation": {
          "label": "Convertir texto a minúsculas",
          "handledChannels": [
            "ui"
          ]
        }
      },
      {
        "command": "pancho.trimLines",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorTextFocus",
        "args": null,
        "accessibilityInformation": {
          "label": "Recortar espacios en líneas",
          "handledChannels": [
            "ui"
          ]
        }
      },
      {
        "command": "pancho.countWords",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "editorTextFocus",
        "args": null,
        "accessibilityInformation": {
          "label": "Contar palabras",
          "handledChannels": [
            "ui"
          ]
        }
      },
      {
        "command": "pancho.countCharacters",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus",
        "args": null,
        "accessibilityInformation": {
          "label": "Contar caracteres",
          "handledChannels": [
            "ui"
          ]
        }
      },
      {
        "command": "pancho.countLines",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "editorTextFocus",
        "args": null,
        "accessibilityInformation": {
          "label": "Contar líneas",
          "handledChannels": [
            "ui"
          ]
        }
      },
      {
        "command": "pancho.sortAscending",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "editorTextFocus",
        "args": null,
        "accessibilityInformation": {
          "label": "Ordenar líneas ascendentemente",
          "handledChannels": [
            "ui"
          ]
        }
      },
      {
        "command": "pancho.removeDuplicateLines",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus",
        "args": null,
        "accessibilityInformation": {
          "label": "Eliminar líneas duplicadas",
          "handledChannels": [
            "ui"
          ]
        }
      }
    ],
