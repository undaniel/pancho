{
  "name": "pancho",
  "displayName": "Pancho",
  "description": "Limpia y formatea texto como Notepad++",
  "version": "1.0.0",
  "publisher": "pancho",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "submenus": [
      {
        "id": "panchoMenu",
        "label": "Pancho"
      },
      {
        "id": "panchoOperaciones",
        "label": "Operaciones de limpieza"
      },
      {
        "id": "panchoTabulaciones",
        "label": "Tabulaciones"
      },
      {
        "id": "panchoInsertar",
        "label": "Insertar"
      },
      {
        "id": "panchoComentarios",
        "label": "Comentar / Descomentar"
      }
    ],
    "commands": [
      {
        "command": "pancho.cleanWhitespace",
        "title": "Limpiar espacios en blanco"
      },
      {
        "command": "pancho.cleanLineEndings",
        "title": "Limpiar saltos de línea"
      },
      {
        "command": "pancho.convertTabsToSpaces",
        "title": "Convertir tabs a espacios"
      },
      {
        "command": "pancho.convertSpacesToTabs",
        "title": "Convertir espacios a tabs"
      },
      {
        "command": "pancho.toUpperCase",
        "title": "Convertir a MAYÚSCULAS"
      },
      {
        "command": "pancho.toLowerCase",
        "title": "Convertir a minúsculas"
      },
      {
        "command": "pancho.toTitleCase",
        "title": "Convertir a Título"
      },
      {
        "command": "pancho.trimLines",
        "title": "Recortar líneas"
      },
      {
        "command": "pancho.lineEndingsToSpaces",
        "title": "Convertir saltos de línea a espacios"
      },
      {
        "command": "pancho.increaseIndent",
        "title": "Aumentar indentación"
      },
      {
        "command": "pancho.decreaseIndent",
        "title": "Disminuir indentación"
      },
      {
        "command": "pancho.insertShortTime",
        "title": "Fecha y hora corta"
      },
      {
        "command": "pancho.insertLongTime",
        "title": "Fecha y hora larga"
      },
      {
        "command": "pancho.insertDateTime",
        "title": "Fecha y hora (dd-MM-yyyy hh:mm:ss)"
      },
      {
        "command": "pancho.commentLine",
        "title": "Comentar línea"
      },
      {
        "command": "pancho.uncommentLine",
        "title": "Descomentar línea"
      },
      {
        "command": "pancho.commentBlock",
        "title": "Comentar bloque"
      },
      {
        "command": "pancho.uncommentBlock",
        "title": "Descomentar bloque"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "panchoMenu"
        }
      ],
      "panchoMenu": [
        {
          "submenu": "panchoOperaciones",
          "label": "Operaciones de limpieza"
        },
        {
          "submenu": "panchoTabulaciones",
          "label": "Tabulaciones"
        },
        {
          "submenu": "panchoInsertar",
          "label": "Insertar"
        },
        {
          "submenu": "panchoComentarios",
          "label": "Comentar / Descomentar"
        }
      ],
      "panchoOperaciones": [
        {
          "command": "pancho.cleanWhitespace"
        },
        {
          "command": "pancho.cleanLineEndings"
        },
        {
          "separator": "before",
          "command": "pancho.toUpperCase"
        },
        {
          "command": "pancho.toLowerCase"
        },
        {
          "command": "pancho.toTitleCase"
        },
        {
          "separator": "before",
          "command": "pancho.trimLines"
        },
        {
          "command": "pancho.lineEndingsToSpaces"
        }
      ],
      "panchoTabulaciones": [
        {
          "command": "pancho.convertTabsToSpaces"
        },
        {
          "command": "pancho.convertSpacesToTabs"
        },
        {
          "separator": "before",
          "command": "pancho.increaseIndent"
        },
        {
          "command": "pancho.decreaseIndent"
        }
      ],
      "panchoInsertar": [
        {
          "command": "pancho.insertShortTime"
        },
        {
          "command": "pancho.insertLongTime"
        },
        {
          "command": "pancho.insertDateTime"
        }
      ],
      "panchoComentarios": [
        {
          "command": "pancho.commentLine"
        },
        {
          "command": "pancho.uncommentLine"
        },
        {
          "separator": "before",
          "command": "pancho.commentBlock"
        },
        {
          "command": "pancho.uncommentBlock"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}