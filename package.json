    "package:production": "npm run bundle:production",
    "generate:readme": "node scripts/generate-readme.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run bundle",
    "build:production": "npm run bundle:production",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "tsc -p tsconfig.test.json && node dist-tests/tests/integration/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
