          "command": "pancho.keepOnlyLinesContaining"
        },
        {
          "separator": "before",
          "command": "pancho.highlightMatches"
        },
        {
          "command": "pancho.countMatches"
        }
      ],
      "panchoEscapar": [
        {
          "command": "pancho.escapeJSON"
        },
        {
          "command": "pancho.unescapeJSON"
        },
        {
          "separator": "before",
          "command": "pancho.escapeForSQL"
        },
        {
          "command": "pancho.unescapeForSQL"
        },
        {
          "separator": "before",
          "command": "pancho.escapeForRegex"
        },
        {
          "separator": "before",
          "command": "pancho.escapeForHTML"
        },
        {
          "command": "pancho.unescapeForHTML"
        }
      ]
    },
    "markdownWalkthrough": [
      {
        "id": "pancho.walkthrough",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "title": "%walkthrough.step.menu.title%",
            "description": "%walkthrough.step.menu.description%",
            "media": {
              "svg": "media/walkthrough.svg"
            }
          },
          {
            "title": "%walkthrough.step.categories.title%",
            "description": "%walkthrough.step.categories.description%",
            "media": {
              "svg": "media/categories.svg"
            }
          },
          {
            "title": "%walkthrough.step.keybindings.title%",
            "description": "%walkthrough.step.keybindings.description%",
            "media": {
              "svg": "media/keybindings.svg"
            }
          },
          {
            "title": "%walkthrough.step.settings.title%",
            "description": "%walkthrough.step.settings.description%",
            "media": {
              "svg": "media/settings.svg"
            }
          }
        ]
      }
    ],
    "colors": [
      {
        "id": "pancho.statusBarBackground",
        "description": "%color.statusBarBackground.description%",
        "defaults": {
          "light": "#007acc",
          "dark": "#007acc"
        }
      },
      {
        "id": "pancho.statusBarForeground",
        "description": "%color.statusBarForeground.description%",
        "defaults": {
          "light": "#ffffff",
          "dark": "#ffffff"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package:production",
    "bundle": "node esbuild.config.mjs",
