{
  "name": "pancho-plus-plus",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.3.0",
  "publisher": "undaniels",
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%",
      "restrictedConfigurations": []
    }
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "text",
    "format",
    "formatter",
    "notepad++",
    "encoding",
    "base64",
    "hash",
    "csv",
    "json",
    "sql",
    "escape"
  ],
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/undaniel/pancho.git"
  },
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "pancho.tabSize": {
          "type": "number",
          "default": 4,
          "description": "%setting.tabSize.description%"
        },
        "pancho.indentWithSpaces": {
          "type": "boolean",
          "default": true,
          "description": "%setting.indentWithSpaces.description%"
        },
        "pancho.defaultEOL": {
          "type": "string",
          "enum": [
            "LF",
            "CRLF",
            "CR"
          ],
          "default": "LF",
          "description": "%setting.defaultEOL.description%"
        },
        "pancho.statusBarShowCounters": {
          "type": "boolean",
          "default": true,
          "description": "%setting.statusBarShowCounters.description%"
        },
        "pancho.maxFileSizeKB": {
          "type": "number",
          "default": 5120,
          "description": "%setting.maxFileSizeKB.description%"
        },
        "pancho.loremIpsumWordCount": {
          "type": "number",
          "default": 50,
          "description": "%setting.loremIpsumWordCount.description%"
        },
        "pancho.randomStringLength": {
          "type": "number",
          "default": 16,
          "description": "%setting.randomStringLength.description%"
        },
        "pancho.regexTimeoutMs": {
          "type": "number",
          "default": 2000,
          "minimum": 50,
          "maximum": 30000,
          "description": "%setting.regexTimeoutMs.description%"
        },
        "pancho.previewDestructive": {
          "type": "boolean",
          "default": false,
          "description": "%setting.previewDestructive.description%"
        },
        "pancho.clipboardHistoryEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%setting.clipboardHistoryEnabled.description%"
        },
        "pancho.clipboardHistorySize": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 100,
          "description": "%setting.clipboardHistorySize.description%"
        }
      }
    },
    "keybindings": [
      {
        "command": "pancho.toUpperCase",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u",
        "when": "editorTextFocus",
        "accessibilityInformation": {
          "label": "%keybinding.toUpperCase.label%"
        }
      },
      {
        "command": "pancho.toLowerCase",
        "key": "ctrl+shift+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus",
        "accessibilityInformation": {
          "label": "%keybinding.toLowerCase.label%"
        }
      },
      {
        "command": "pancho.trimLines",
        "key": "ctrl+shift+t",
        "mac": "cmd+alt+t",
        "when": "editorTextFocus",
        "accessibilityInformation": {
          "label": "%keybinding.trimLines.label%"
        }
      },
      {
        "command": "pancho.countWords",
        "key": "ctrl+shift+w",
        "mac": "cmd+alt+w",
        "when": "editorTextFocus",
        "accessibilityInformation": {
          "label": "%keybinding.countWords.label%"
        }
      },
      {
        "command": "pancho.countCharacters",
        "key": "ctrl+shift+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus",
        "accessibilityInformation": {
          "label": "%keybinding.countCharacters.label%"
        }
      },
      {
        "command": "pancho.countLines",
        "key": "ctrl+shift+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus",
        "accessibilityInformation": {
          "label": "%keybinding.countLines.label%"
        }
      },
      {
        "command": "pancho.sortAscending",
        "key": "ctrl+shift+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus",
        "accessibilityInformation": {
          "label": "%keybinding.sortAscending.label%"
        }
      },
      {
        "command": "pancho.removeDuplicateLines",
        "key": "ctrl+shift+d",
        "mac": "cmd+alt+d",
        "when": "editorTextFocus",
        "accessibilityInformation": {
          "label": "%keybinding.removeDuplicateLines.label%"
        }
      },
      {
        "command": "pancho.repeatLast",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "editorTextFocus",
        "accessibilityInformation": {
          "label": "%keybinding.repeatLast.label%"
        }
      },
      {
        "command": "pancho.clipboardHistory",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus",
        "accessibilityInformation": {
          "label": "%keybinding.clipboardHistory.label%"
        }
      },
      {
        "command": "pancho.regexTesterPanel",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "accessibilityInformation": {
          "label": "%keybinding.regexTesterPanel.label%"
        }
      }
    ],
